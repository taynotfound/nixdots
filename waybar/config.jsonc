{
  "layer": "top",
  "position": "top",
  "height": 38,
  "spacing": 4,
  "margin-top": 7,
  "margin-left": 10,
  "margin-right": 10,

  "modules-left": [
    "custom/launcher",
    "hyprland/workspaces",
    "hyprland/window"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "custom/minimized",
    "custom/hidden",
    "custom/media",
    "custom/gpu",
    "cpu",
    "memory",
    "pulseaudio",
    "network",
    "bluetooth",
    "tray",
    "custom/notifications",
    "custom/power"
  ],

  "custom/launcher": {
    "format": "",
    "tooltip": "Applications",
    "on-click": "rofi -show drun"
  },

  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "1": "󰲠",
      "2": "󰲢",
      "3": "󰲤",
      "4": "󰲦",
      "5": "󰲨",
      "6": "󰲪",
      "7": "󰲬",
      "8": "󰲮",
      "9": "󰲰",
      "active": "󰮯",
      "urgent": "󰀦",
      "default": "󰧞"
    },
    "persistent-workspaces": {
      "*": 5
    },
    "on-click": "activate",
    "sort-by-number": true
  },

  "hyprland/window": {
    "format": "{class}  ·  {title}",
    "max-length": 52,
    "separate-outputs": true,
    "rewrite": {
      "(.*) — Mozilla Firefox": "$1",
      "": "Desktop"
    }
  },

  "clock": {
    "format": "{:%H:%M    %a %d %b}",
    "format-alt": "{:%A, %d %B %Y  ·  %H:%M:%S}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "weeks-pos": "right",
      "on-scroll": 1
    }
  },

  "custom/minimized": {
    "return-type": "json",
    "exec": "nixdots-windowctl status minimized",
    "interval": 1,
    "on-click": "nixdots-windowctl restore minimized"
  },

  "custom/hidden": {
    "return-type": "json",
    "exec": "nixdots-windowctl status hidden",
    "interval": 1,
    "on-click": "nixdots-windowctl restore hidden"
  },

  "custom/media": {
    "return-type": "json",
    "format": "{icon} {text}",
    "format-icons": {
      "Playing": "",
      "Paused": ""
    },
    "max-length": 28,
    "exec": "playerctl -a metadata --format '{\"text\":\"{{markup_escape(title)}}\",\"tooltip\":\"{{markup_escape(artist)}} — {{markup_escape(title)}}\",\"alt\":\"{{status}}\"}' -F",
    "on-click": "playerctl play-pause",
    "on-click-right": "playerctl next"
  },

  "custom/gpu": {
    "exec-if": "command -v nvidia-smi >/dev/null 2>&1",
    "exec": "nvidia-smi --query-gpu=utilization.gpu,temperature.gpu --format=csv,noheader,nounits | awk -F ', ' '{print \" \" $1 \"%  \" $2 \"°C\"}'",
    "interval": 3,
    "tooltip": false
  },

  "cpu": {
    "format": " {usage}%",
    "interval": 3,
    "tooltip": false
  },
  "memory": {
    "format": " {percentage}%",
    "interval": 3,
    "tooltip": false
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": " muted",
    "format-icons": {
      "headphone": "",
      "default": ["", "", ""]
    },
    "on-click": "pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  },
  "network": {
    "format-wifi": " {signalStrength}%",
    "format-ethernet": "",
    "format-disconnected": "",
    "tooltip-format": "{ifname} · {ipaddr}",
    "on-click": "nm-connection-editor"
  },
  "bluetooth": {
    "format": "",
    "format-disabled": "",
    "format-connected": " {num_connections}",
    "on-click": "blueman-manager"
  },
  "tray": {
    "icon-size": 18,
    "spacing": 8
  },
  "custom/notifications": {
    "return-type": "json",
    "exec-if": "command -v swaync-client >/dev/null 2>&1",
    "exec": "swaync-client -swb",
    "format": "{icon}",
    "format-icons": {
      "notification": "",
      "none": "",
      "dnd-notification": "",
      "dnd-none": ""
    },
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw"
  },
  "custom/power": {
    "format": "",
    "tooltip": "Power menu",
    "on-click": "wlogout"
  }
}
